   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Reckon Vendor Superuser",
   "create": 1,
   "read": 1,
   "write": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Reckon Sales Agent Admin",
   "create": 1,
   "read": 1,
   "write": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Reckon Sales Agent Manager",
   "create": 1,
   "read": 1,
   "write": 1,
   "report": 1,
   "export": 1,
   "print": 1,
