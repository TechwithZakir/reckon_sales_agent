{
 "doctype": "DocType",
 "name": "Sales Campaign Step",
 "module": "Reckon Sales Agent",
 "owner": "Administrator",
 "creation": "2026-10-19 12:00:00.000000",
 "modified": "2026-10-26 17:00:00.000000",
 "modified_by": "Administrator",
 "custom": 0,
 "engine": "InnoDB",
 "istable": 1,
 "issingle": 0,
 "editable_grid": 1,
 "track_changes": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "states": [],
 "field_order": [
  "step_no",
  "channel",
  "delay_days",
  "subject_template",
  "body_template",
  "use_ai_personalisation",
  "whatsapp_template",
  "whatsapp_template_params"
 ],
 "fields": [
  {
   "fieldname": "step_no",
   "fieldtype": "Int",
   "label": "Step No",
   "in_list_view": 1,
   "reqd": 1
  },
  {
   "fieldname": "channel",
   "fieldtype": "Select",
   "label": "Channel",
   "options": "Email\nSMS\nWhatsApp\nCall Task\nLinkedIn Task",
   "default": "Email",
   "in_list_view": 1
  },
  {
   "fieldname": "delay_days",
   "fieldtype": "Int",
   "label": "Delay Days",
   "in_list_view": 1,
   "default": "0",
   "description": "Days after the previous step (business days are not modelled)."
  },
  {
   "fieldname": "subject_template",
   "fieldtype": "Data",
   "label": "Subject Template",
   "in_list_view": 1,
   "mandatory_depends_on": "eval:doc.channel=='Email'",
   "description": "Email only; SMS, WhatsApp and tasks have no subject."
  },
  {
   "fieldname": "body_template",
   "fieldtype": "Text",
   "label": "Body Template",
   "reqd": 1,
   "description": "Placeholders: {{business_name}}, {{city}}, {{industry}}, {{sender_name}}, {{offer}}, {{personal_line}}"
  },
  {
   "fieldname": "use_ai_personalisation",
   "fieldtype": "Check",
   "label": "Personalise with AI",
   "default": "0"
  },
  {
   "fieldname": "whatsapp_template",
   "fieldtype": "Data",
   "label": "WhatsApp Template",
   "description": "Name of an approved WhatsApp template (frappe_whatsapp). Needed to message someone who has not written in the last 24 hours.",
   "depends_on": "eval:doc.channel=='WhatsApp'"
  },
  {
   "fieldname": "whatsapp_template_params",
   "fieldtype": "Data",
   "label": "Template Parameters",
   "description": "Placeholders for {{1}}, {{2}}... in order, e.g. business_name, sender_name",
   "depends_on": "eval:doc.channel=='WhatsApp'"
  }
 ],
 "permissions": []
}
