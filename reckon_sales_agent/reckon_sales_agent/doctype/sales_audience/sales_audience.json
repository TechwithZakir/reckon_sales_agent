 "fields": [
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "reqd": 1,
   "in_standard_filter": 1,
   "search_index": 1,
   "remember_last_selected_value": 1
  },
  {
   "fieldname": "audience_name",
   "fieldtype": "Data",
   "label": "Audience name",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "audience_type",
   "fieldtype": "Select",
   "label": "Who is in it",
   "options": "Prospects\nCRM Leads\nCRM Contacts\nCustomers\nSpecific people\nSegment",
   "default": "Prospects",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Prospects: approved Sales Prospects. CRM Leads and Contacts: records in Frappe CRM. Customers: contacts with a won deal. Specific people: a list you pick. Segment: a saved segment's rules, checked every time."
  },
  {
   "fieldname": "segment",
   "fieldtype": "Link",
   "label": "Segment",
   "options": "Sales Segment",
   "depends_on": "eval:doc.audience_type=='Segment'",
   "mandatory_depends_on": "eval:doc.audience_type=='Segment'"
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  },
  {
   "fieldname": "filters_section",
   "fieldtype": "Section Break",
   "label": "Who to include",
   "depends_on": "eval:doc.audience_type!='Specific people'"
  },
  {
   "fieldname": "status_filter",
   "fieldtype": "Small Text",
   "label": "Statuses",
   "depends_on": "eval:doc.audience_type=='CRM Leads'",
   "description": "CRM lead statuses, comma separated, e.g. New, Contacted. Empty means every status."
  },
  {
   "fieldname": "source_filter",
   "fieldtype": "Data",
   "label": "Source",
   "depends_on": "eval:['Prospects','CRM Leads'].includes(doc.audience_type)",
   "description": "Prospects: where they were found (source type). Leads: the lead source."
  },
  {
   "fieldname": "owner_filter",
   "fieldtype": "Link",
   "label": "Owner",
   "options": "User",
   "depends_on": "eval:doc.audience_type=='CRM Leads'"
  },
  {
   "fieldname": "filters_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "city_filter",
   "fieldtype": "Data",
   "label": "City",
   "depends_on": "eval:doc.audience_type=='Prospects'"
  },
  {
   "fieldname": "industry_filter",
   "fieldtype": "Data",
   "label": "Industry",
   "depends_on": "eval:doc.audience_type=='Prospects'"
  },
  {
   "fieldname": "minimum_fit_score",
   "fieldtype": "Float",
   "label": "Minimum fit score",
   "depends_on": "eval:doc.audience_type=='Prospects'"
  },
  {
   "fieldname": "require_email",
   "fieldtype": "Check",
   "label": "Only people with an email"
  },
  {
   "fieldname": "require_phone",
   "fieldtype": "Check",
   "label": "Only people with a phone"
  },
  {
   "fieldname": "people_section",
   "fieldtype": "Section Break",
   "label": "People",
   "depends_on": "eval:doc.audience_type=='Specific people'"
  },
  {
   "fieldname": "members",
   "fieldtype": "Table",
   "label": "People",
   "options": "Sales Audience Member"
  },
  {
   "fieldname": "consent_section",
   "fieldtype": "Section Break",
   "label": "Permission for SMS and WhatsApp",
   "collapsible": 1,
